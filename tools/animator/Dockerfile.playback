FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium-headless-shell ffmpeg fonts-liberation fonts-dejavu-core ca-certificates python3 python3-pil \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/animator
COPY package.json package-lock.json ./
RUN npm ci
COPY render-video.mjs render-remotion.mjs render-canvas.mjs verify-remotion.mjs review-project.mjs ./
ENV NODE_PATH=/opt/animator/node_modules \
    REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium-headless-shell \
    HOME=/tmp/home DO_NOT_TRACK=1 CI=1
ENTRYPOINT ["node", "/opt/animator/render-video.mjs"]
