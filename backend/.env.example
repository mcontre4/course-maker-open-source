COURSE_MAKER_DATABASE_URL=mysql+pymysql://course_maker:local-password@localhost:3306/course_maker?charset=utf8mb4
COURSE_MAKER_REDIS_URL=redis://localhost:6379/0
# Generate a private key, e.g. python -c 'import secrets; print(secrets.token_urlsafe(32))'
COURSE_MAKER_API_KEY=
# Separate staff key for /internal/tools; empty disables internal diagnostics.
COURSE_MAKER_INTERNAL_TOOLS_KEY=
COURSE_MAKER_CORS_ORIGINS=["http://localhost:5173"]
# Keep the existing API-key/anonymous-owner flow until accounts are ready.
COURSE_MAKER_AUTH_ENABLED=false
# Exact browser origin. HTTPS is required except on loopback development hosts.
COURSE_MAKER_AUTH_PUBLIC_URL=http://localhost:5173
COURSE_MAKER_AUTH_SESSION_SECONDS=28800
COURSE_MAKER_AUTH_IDLE_SECONDS=1800
# Stripe test-mode keys work locally. Configure both values, or leave both empty.
COURSE_MAKER_STRIPE_SECRET_KEY=
COURSE_MAKER_STRIPE_WEBHOOK_SECRET=
# Non-expiring credits; existing and new accounts start at zero.
COURSE_MAKER_CREDIT_CREATE_COST=1
COURSE_MAKER_CREDIT_GENERATE_COST=5
COURSE_MAKER_CREDIT_MEDIA_COST=10
COURSE_MAKER_CREDIT_AUTOMATIC_COST=25
# Google OAuth WEB client; callback: <AUTH_PUBLIC_URL>/api/v1/auth/google/callback
COURSE_MAKER_GOOGLE_CLIENT_ID=
COURSE_MAKER_GOOGLE_CLIENT_SECRET=
# Local Mailpit inbox: http://localhost:8025. Production requires SMTP STARTTLS.
COURSE_MAKER_SMTP_HOST=mailpit
COURSE_MAKER_SMTP_PORT=1025
COURSE_MAKER_SMTP_STARTTLS=false
COURSE_MAKER_SMTP_USERNAME=
COURSE_MAKER_SMTP_PASSWORD=
COURSE_MAKER_MAIL_FROM=accounts@localhost
# Optional: absent configuration returns 503 from asset endpoints.
# COURSE_MAKER_GCP_PROJECT=your-project
# COURSE_MAKER_GCS_BUCKET=your-private-bucket
# COURSE_MAKER_GCS_SIGNER_EMAIL=course-maker-storage@your-project.iam.gserviceaccount.com
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# Syllabus agent (install with poetry install --extras ai).
COURSE_MAKER_OPENROUTER_API_KEY=
# Independent of lesson generation mode; writes SVG code using the approved website style.
COURSE_MAKER_THUMBNAIL_MODEL=openai/gpt-6.1-sol
COURSE_MAKER_TAVILY_API_KEY=

# Optional local API port and frontend development proxy target.
# COURSE_MAKER_API_PORT=8000
# COURSE_MAKER_API_URL=http://127.0.0.1:8000

# Lesson Creator (reuses the OpenRouter and Tavily keys above).

# Script & Storyboard (reuses OpenRouter; no research key required).

# TTS and alignment: ElevenLabs v4, 24 kHz mono WAV.
COURSE_MAKER_ELEVENLABS_API_KEY=
# Optional effective account rate: monthly USD / included credits, or your contracted rate.
# Dollar conversions are labelled estimates. Omit to keep speech spend pending.
# COURSE_MAKER_ELEVENLABS_USD_PER_CREDIT=0.0002
COURSE_MAKER_ELEVENLABS_VOICE_ID=6WwXjDDEMyNmFG95zycZ
COURSE_MAKER_SPEECH_STORAGE_BACKEND=local
COURSE_MAKER_SPEECH_LOCAL_DIRECTORY=.artifacts/speech
# COURSE_MAKER_SPEECH_STORAGE_BACKEND=gcs  # reuses the private GCS bucket above
# COURSE_MAKER_SPEECH_SILENCE_BETWEEN_SCENES_SEC=0.25

# Stage 4.5: requires npm ci and a built Docker worker image (docs/animator-agent.md).
COURSE_MAKER_ANIMATOR_TOOLS_DIRECTORY=../tools/animator
COURSE_MAKER_ANIMATION_LOCAL_DIRECTORY=.artifacts/animation
COURSE_MAKER_ANIMATOR_IMAGE=course-maker-animator:canvas-v1
# Optional per-worker deadline override (60–1800 seconds); default 1800.
# COURSE_MAKER_ANIMATOR_TIMEOUT_SEC=1800
COURSE_MAKER_ANIMATOR_MAX_ATTEMPTS=2

# Isolated, deterministic JavaScript video delivery and legacy playback (local Docker).
COURSE_MAKER_LESSON_VIDEO_IMAGE=course-maker-renderer:canvas-v1
